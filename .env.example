# =============================================================================
# Eyedentity Frontend — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values.
#   cp .env.example .env.local
# NEVER commit .env.local to version control.
# =============================================================================

# Full URL of the FastAPI backend (local dev or deployed Render URL).
# Required: app cannot process iris images without this.
NEXT_PUBLIC_BACKEND_URL=https://localhost:8000
