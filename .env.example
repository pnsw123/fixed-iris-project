# =============================================================================
# Eyedentity Frontend — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values.
#   cp .env.example .env.local
# NEVER commit .env.local to version control.
# =============================================================================

# Full URL of the FastAPI backend (local dev or deployed Railway/Render URL).
# Required: app cannot process iris images without this.
NEXT_PUBLIC_BACKEND_URL=https://localhost:8000

# Lemon Squeezy checkout URL for the HD image purchase.
# Required: "Buy HD" button is non-functional without this.
