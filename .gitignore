# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
vitest-results/
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ignore large model files
*.pt
*.pth
*.onnx
public/models/**
backend/models/**
public/test_iris_sharp.png


# Tribal extraction output
tribal_extraction_output/

# Python distribution / packaging
*.egg-info/
*.egg
dist/
MANIFEST
*.whl

# mypy cache
.mypy_cache/

# ruff cache
.ruff_cache/

# Python cache
scripts/extraction/__pycache__/
scripts/extraction/*.pyc
**/__pycache__/
*.pyc

# Test cache
.pytest_cache/
*.pytest_cache

# Environment
anthropic_api_key.txt

# Large folders
backend/venv/
Data/
tribal_validation_pipeline/
*.dylib
*.pth

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
Thumbs.db
._*

# Python virtual environments
.venv/
env/

# Logs
*.log

# Test artifacts
.coverage
coverage.xml

# Compiled Python extensions
*.so

# SSL certificates (security risk)
.cert/

# AI session plan artifacts (Claude Code orchestrator)
.claude/fix-*-plan.md

# Runtime logs in subdirectories
backend/*.log
