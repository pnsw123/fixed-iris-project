# =============================================================================
# Eyedentity Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
#
#   cp backend/.env.example backend/.env
#
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Bind address and port for the FastAPI/Uvicorn server.
HOST=0.0.0.0
PORT=8000

# Number of Uvicorn worker processes (set > 1 in production).
WORKERS=1

# Enable hot-reload (set to false in production).
RELOAD=true

# Compute device for ML inference: mps (Apple Silicon), cuda (NVIDIA), or cpu.
DEVICE=mps

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Runtime environment — set ENV=production on deployed servers.
ENV=development

# CORS — JSON array of allowed origins. Default covers common local dev ports;
# override for production.
# CORS_ORIGINS=["https://yourdomain.com"]

# Set TRUSTED_PROXY=true when behind a single trusted load balancer (e.g. Render)
# so rate limiting uses the real client IP from X-Forwarded-For.
TRUSTED_PROXY=false


# -----------------------------------------------------------------------------
# IMAGE STORAGE — Redis
# -----------------------------------------------------------------------------

# Backend for storing processed images: "memory" (dev default) or "redis"
# (production). Use "redis" so images survive restarts and are shared across
# workers. Env var name is PURCHASE_BACKEND for deployment compatibility.
PURCHASE_BACKEND=memory

# Redis connection URL (required when PURCHASE_BACKEND=redis).
# Format: redis://[:password@]host[:port][/db-number]
# REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# MODEL PATHS — defaults point to ./models/ relative to backend dir
# -----------------------------------------------------------------------------

# Fine-tuned IrisSAM model weights (.pt file).
IRIS_SAM_MODEL=./models/IrisSAM_model.pt

# Base SAM ViT-B checkpoint (.pth file).
SAM_CHECKPOINT=./models/sam_vit_b_01ec64.pth

# SAM backbone variant: auto | vit_b | vit_l | vit_h
# "auto" detects from fine-tuned weights — recommended.
SAM_MODEL_TYPE=auto

# Real-ESRGAN upscaling model weights (.pth file).
ESRGAN_MODEL=./models/realesr-general-x4v3.pth
