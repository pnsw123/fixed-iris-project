# =============================================================================
# Eyedentity Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
#
#   cp backend/.env.example backend/.env
#
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# PAYMENT — Lemon Squeezy
# -----------------------------------------------------------------------------

# Webhook signing secret from Lemon Squeezy dashboard → Settings → Webhooks.
# Required: backend rejects ALL incoming webhooks if this is not set.
# Format: a random string (LS generates it for you when creating the webhook).
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemon-squeezy-webhook-secret-here


# -----------------------------------------------------------------------------
# EMAIL — SendGrid
# -----------------------------------------------------------------------------

# SendGrid API key for sending download-link emails after purchase.
# Required: email delivery is silently skipped if this is not set.
# Create at: https://app.sendgrid.com/settings/api_keys
# Minimum permission: Mail Send
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Sender address that appears in the "From" field of download emails.
# Must be a verified sender in your SendGrid account.
FROM_EMAIL=downloads@yourdomain.com


# -----------------------------------------------------------------------------
# AUTH — JWT
# -----------------------------------------------------------------------------

# Secret key used to sign JWT download tokens (48-hour expiry).
# Required: use a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: the default fallback value in code is insecure — always set this.
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production


# -----------------------------------------------------------------------------
# SERVER — Base URL
# -----------------------------------------------------------------------------

# Public base URL of the frontend/backend, used to build download links in emails.
# No trailing slash.
# Examples:
#   Production:  https://eyedentity.app
#   Local dev:   http://localhost:3000
BASE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# SERVER — Optional / Defaults shown
# -----------------------------------------------------------------------------

# Bind address and port for the FastAPI/Uvicorn server.
HOST=0.0.0.0
PORT=8000

# Number of Uvicorn worker processes (set > 1 in production).
WORKERS=1

# Enable hot-reload (set to false in production).
RELOAD=true

# Compute device for ML inference: mps (Apple Silicon), cuda (NVIDIA), or cpu.
DEVICE=mps

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins (JSON array syntax).
# Default covers common local dev ports; override for production.
# CORS_ORIGINS=["https://yourdomain.com"]


# -----------------------------------------------------------------------------
# MODEL PATHS — defaults point to ./models/ relative to backend dir
# -----------------------------------------------------------------------------

# Fine-tuned IrisSAM model weights (.pt file).
IRIS_SAM_MODEL=./models/IrisSAM_model.pt

# Base SAM ViT-B checkpoint (.pth file).
SAM_CHECKPOINT=./models/sam_vit_b_01ec64.pth

# SAM backbone variant: auto | vit_b | vit_l | vit_h
# "auto" detects from fine-tuned weights — recommended.
SAM_MODEL_TYPE=auto

# Real-ESRGAN upscaling model weights (.pth file).
ESRGAN_MODEL=./models/realesr-general-x4v3.pth
